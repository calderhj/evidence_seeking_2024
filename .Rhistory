data <- data.frame(
name = c("Antagonist":"Control"),
value= c(27, 30),
sd=c(4, 3)
)
ggplot(data) +
geom_bar( aes(x= ["Antagonist", "Control"], y= [27, 30]), stat="identity", fill="skyblue", alpha=0.7) +
geom_errorbar( aes(x=name, ymin=value-sd, ymax=value+sd), width=0.4, colour="orange", alpha=0.9, size=1.3)
plot(ggplot(data) +
geom_bar( aes(x= ["Antagonist", "Control"], y= [27, 30]), stat="identity", fill="skyblue", alpha=0.7) +
geom_errorbar( aes(x=name, ymin=value-sd, ymax=value+sd), width=0.4, colour="orange", alpha=0.9, size=1.3))
plot(data)
myplot <- ggplot(data) +
geom_bar( aes(x= ["Antagonist", "Control"], y= [27, 30]), stat="identity", fill="skyblue", alpha=0.7) +
geom_errorbar( aes(x=name, ymin=value-sd, ymax=value+sd), width=0.4, colour="orange", alpha=0.9, size=1.3)
plot(myplot)
